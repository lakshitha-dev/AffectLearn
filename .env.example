# PostgreSQL
POSTGRES_DB=affectlearn
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/affectlearn
REDIS_URL=redis://redis:6379
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
VLLM_ENDPOINT=http://vllm:8080
# Video help ("Watch a video explanation"): YouTube Data API v3 key. Empty = the agent
# returns a YouTube search link instead of an embedded video.
YOUTUBE_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Set to "1" to enable the affect-detection debug overlay (Story 4.2).
NEXT_PUBLIC_AFFECT_DEBUG=
