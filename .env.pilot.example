# Secrets for the in-person pilot stack (docker-compose.pilot.yml).
#
# Copy to `.env.pilot` (git-ignored), fill in, and keep it on the encrypted pilot laptop only.
# Generate the random values with, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Every setting that shapes the research (models, gate, LLM, withholding) is in
# docker-compose.pilot.yml, not here, so it is versioned with the code it configures.

# Signs access tokens. Unique to this laptop; never reuse the Azure value.
JWT_SECRET=
# Encrypts an LLM key saved from the admin settings page. Independent of JWT_SECRET.
CONFIG_SECRET_KEY=

# The facilitator's admin login (admin@affectlearn.io). Strong and unique.
SEED_ADMIN_PASSWORD=
# The seeded learner and designer accounts are not used in the pilot; give them strong random
# passwords so they cannot be signed in to.
SEED_LEARNER_PASSWORD=
SEED_DESIGNER_PASSWORD=

# gpt-4o writes the adaptive arm's help messages, as in the deployment. The key is sent to OpenAI
# only; the participant's name, e-mail and account are never part of a prompt.
OPENAI_API_KEY=

# Optional: embedded videos for the `show_video` card. Empty = a YouTube search link instead.
YOUTUBE_API_KEY=

# Stamped on every session_provenance event. Set it when starting the stack:
#   APP_COMMIT=$(git rev-parse --short HEAD) docker compose ... up -d --build
APP_COMMIT=
