# Azure App Settings for the AffectLearn BACKEND (App Service → Configuration → Application settings).
# These mirror backend/.env.example but point at managed Azure services.
# Set them via `az webapp config appsettings set` (see provision.sh / DEPLOY.md).

# --- Database (Azure Database for PostgreSQL Flexible Server; SSL required) ---
DATABASE_URL=postgresql+asyncpg://<pg_admin>:<pg_password>@<pg_name>.postgres.database.azure.com:5432/affectlearn?ssl=require

# --- Redis (Azure Cache for Redis; TLS 6380) ---
REDIS_URL=rediss://:<redis_primary_key>@<redis_name>.redis.cache.windows.net:6380/0

# --- Auth ---
JWT_SECRET=<generate-a-long-random-string>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM (Phase B only; leave pointing nowhere for CPU-only Phase A — nodes fall back to rules) ---
VLLM_ENDPOINT=http://<gpu-vm-private-ip>:8000
VLLM_MODEL=affectlearn/llama-3-8b-pedagogical

# --- Affect models (paths inside the container) ---
AFFECT_MODEL_PATH=models/cnn_lstm_best.onnx
AFFECT_MODEL_KIND=engagement
BEHAVIORAL_MODEL_PATH=models/behavioral_bilstm.onnx
BEHAVIORAL_STATS_PATH=models/behavioral_feature_stats.json
AFFECT_DETECTION_MODE=auto
# SAS URL to the 46MB facial ONNX in Blob (entrypoint fetches it if not in the image):
FACIAL_MODEL_URL=https://<storage>.blob.core.windows.net/models/cnn_lstm_best.onnx?<sas-token>

# --- App ---
ENVIRONMENT=production
SEED_ON_STARTUP=false
EXPOSE_DEV_CREDENTIALS=false
WEB_CONCURRENCY=2
# Allow the Static Web App origin (CORS). Set to your SWA URL.
CORS_ORIGINS=https://<your-swa-name>.azurestaticapps.net

# --- Frontend (Static Web Apps → Configuration; build-time NEXT_PUBLIC_*) ---
# NEXT_PUBLIC_API_URL=https://<backend-app>.azurewebsites.net/api/v1
# NEXT_PUBLIC_WS_URL=wss://<backend-app>.azurewebsites.net
