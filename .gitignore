# Node
node_modules/
.next/
.env.local
next-env.d.ts
tsconfig.tsbuildinfo

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Environment
.env
!.env.example
# Pilot: secrets, participant credentials and exported data never enter the repository.
.env.pilot
pilot_accounts*.csv
pilot_export*/
simulation_report*/
backup-*.sql

# IDE
.vscode/
.idea/
.claude/

# Docker
pgdata/

# Local SQLite, for running the stack without Postgres (scripts and the dev harness
# default to it). Never a real database, always disposable.
*.sqlite
*.sqlite3
backend/*.db

# OS
.DS_Store
Thumbs.db

# Large facial affect model (46MB ResNet18 CNN-LSTM) — fetch from Google Drive into
# backend/models/, not committed. See backend/models/README.md.
# (behavioral_bilstm.onnx is small and stays tracked.)
# Facial CNN-LSTM artifacts are ~48MB each; they are fetched from Blob at deploy time
# (.github/workflows/deploy.yml). Ignore the SIZE CLASS, not one filename -- naming a single
# file meant the next export slipped past the rule and would have been committed.
backend/models/cnn_lstm_*.onnx
backend/models/*.onnx.data
# The small provenance cards ARE committed: they carry the honest metrics and must travel
# with the code that loads them.
!backend/models/cnn_lstm_*.json

# Azure deploy local secrets/names
deploy/azure/.deploy-secrets
deploy/azure/.deploy-names
deploy/azure/DEPLOYMENT_STATUS.md

# Playwright output. Both are regenerated on every run and neither belongs in
# history; `figures.spec.ts` writes its captures into docs/thesis/figures instead,
# which is where the thesis reads them from.
frontend/playwright-report/
frontend/test-results/

# Offline LLM evaluation (backend/scripts/eval_llm_offline.py). Per-run raw model outputs stay
# local, and so do the dry-run's numbers: they come from a fake client and describe the harness,
# not the model. The scenario set and the live aggregate results are committed.
backend/scripts/eval_llm_offline_raw*.jsonl
backend/scripts/eval_llm_offline_results_dryrun.json
