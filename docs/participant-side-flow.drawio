        <mxCell id="bgnote" value="Runs INVISIBLY in the background while they read:&#10;behavioral signals (mouse · scroll · keystroke category · timing) every ~30 s,&#10;plus webcam frames if the camera is on. The participant does nothing extra." style="shape=note;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="400" y="450" width="450" height="80" as="geometry" /></mxCell>

