        <mxCell id="g3" value="PAUSE POINT (every 3 sections):&#10;inline “Quick check” bar — “How are you feeling?”&#10;one click: Engaged / Confused / Bored / Frustrated / Neutral  ·  or Skip&#10;(inline bar, NOT a pop-up · under 5 s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="630" y="225" width="220" height="120" as="geometry" /></mxCell>
