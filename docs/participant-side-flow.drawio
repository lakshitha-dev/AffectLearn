        <mxCell id="f" value="Browse courses → Enroll → Open a lesson" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="425" width="230" height="50" as="geometry" /></mxCell>
