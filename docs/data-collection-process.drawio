          <mxGeometry x="285" y="205" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="beh" value="Behavioral capture&#10;mouse moves/clicks · scroll ·&#10;keystroke CATEGORY · idle/visibility · timing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="285" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fac" value="Facial capture (optional)&#10;webcam frames read in memory&#10;— never written to disk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="290" y="285" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="self" value="Self-report at pause points&#10;learner picks their true feeling&#10;➜ GROUND-TRUTH label" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="285" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="win" value="Bundle a ~30-second WINDOW  →  send over WebSocket (JWT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="410" width="430" height="44" as="geometry" />
        </mxCell>

        <!-- ===== Backend band nodes ===== -->
        <mxCell id="ws" value="WebSocket handler&#10;auth + dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
