          <mxGeometry x="590" y="525" width="135" height="60" as="geometry" />
        </mxCell>
        <mxCell id="emit" value="research_logger.emit()  — one event per classification / interaction / self-report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="660" height="44" as="geometry" />
        </mxCell>

        <!-- ===== Durability & storage band ===== -->
        <mxCell id="redis" value="Redis stream&#10;(best-effort buffer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="80" y="780" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="worker" value="Background worker&#10;drains stream → batch insert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="300" y="780" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="re" value="PostgreSQL — research_events&#10;DURABLE event store · per-session · sequence-numbered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="870" width="450" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Side notes ===== -->
        <mxCell id="n_collect" value="WHAT'S COLLECTED  (research_events rows)&#10;&#10;• behavioral_affect_detected&#10;• facial_affect_detected&#10;• multimodal_affect_detected&#10;• self_report  (ground truth)&#10;• adaptation_interaction&#10;• learner_profile_updated&#10;&#10;Each row carries:&#10;affect_state + probabilities&#10;{engaged, bored, confused, frustrated}&#10;+ confidence · detection_mode&#10;· learner_id · session_id · cycle&#10;· timestamp · sequence_number&#10;· phase (A/B) · group (control/adaptive)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="770" y="500" width="340" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n_privacy" value="PRIVACY&#10;• No video is ever stored (frames in memory only)&#10;• Keystroke CONTENT never captured — only category&#10;• Consent required before any capture" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="770" y="820" width="340" height="110" as="geometry" />
        </mxCell>

