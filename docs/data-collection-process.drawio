        <mxCell id="onb" value="Onboarding &amp; setup&#10;consent · webcam choice · pre-questionnaire" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="35" width="250" height="60" as="geometry" />
        </mxCell>
