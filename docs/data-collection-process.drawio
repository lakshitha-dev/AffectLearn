<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Data Collection Process" id="datacollect1">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== Section background bands ===== -->
        <mxCell id="band_browser" value="① BROWSER  (participant's device — capture &amp; stream)" style="rounded=1;fillColor=#eaf2fb;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
