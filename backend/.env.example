DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/affectlearn
REDIS_URL=redis://redis:6379
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
VLLM_ENDPOINT=http://vllm:8080

# ── Affect / ML pipeline (Epic 4) ──────────────────────────────────────────────
# Model paths are relative to the backend working dir (./models). Behavioral is wired;
# facial uses the engagement stand-in until the 4-category CNN-LSTM ONNX is exported.
AFFECT_MODEL_PATH=models/cnn_lstm_best.onnx        # facial CNN-LSTM (drop-in when exported)
AFFECT_MODEL_KIND=engagement                       # engagement | category
BEHAVIORAL_MODEL_PATH=models/behavioral_bilstm.onnx
BEHAVIORAL_STATS_PATH=models/behavioral_feature_stats.json
AFFECT_DETECTION_MODE=auto                          # auto | facial_only | behavioral_only | multimodal (ablation, FR14)
# BEHAVIORAL_VIEWPORT_W=1920                         # optional: mouse-coord normalization viewport
# BEHAVIORAL_VIEWPORT_H=1080
# RESEARCH_STREAM_MAXLEN=100000                      # optional: research-event stream cap
# PROFILE_COLD_PERSIST_EVERY=10                      # optional: profiler Postgres write cadence
