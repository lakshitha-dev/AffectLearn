DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/affectlearn
REDIS_URL=redis://redis:6379
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
VLLM_ENDPOINT=http://vllm:8080
# Video help ("Watch a video explanation"): YouTube Data API v3 key. Empty = the agent
# returns a YouTube search link instead of an embedded video.
YOUTUBE_API_KEY=

# ── Affect / ML pipeline (Epic 4) ──────────────────────────────────────────────
# Model paths are relative to the backend working dir (./models). BOTH channels now run real
# models trained on real people, and both detect BINARY CONFUSION — the only one of the four
# target states that is detectable in the available data (see reports/ in the ML repo).
# `engaged` is the absence of detected confusion, not a detection; `bored` and `frustrated`
# are structurally 0.0 and can never occur.
# Facial: the binary CONFUSION model (AUC 0.641, kappa 0.212 on DAiSEE's 1638-clip test split).
# Set BOTH of these together — pointing KIND at binary_confusion while PATH still resolves to the
# old 4-level engagement artifact produces confident nonsense, not an error. Check which pair is
# actually loaded with GET /health/pipeline -> models.
AFFECT_MODEL_PATH=models/cnn_lstm_confusion_anycut.onnx
AFFECT_MODEL_KIND=binary_confusion                 # engagement | category | binary_confusion
# Behavioural: the DUX-trained confusion GBDT (AUC 0.747, kappa 0.274, 46 participants, LOPO).
# Replaces behavioral_bilstm.onnx, which was exported from a checkpoint stamped
# trained_on: "synthetic" (600 fabricated windows, 15 fabricated participants).
BEHAVIORAL_MODEL_PATH=models/behavioral_confusion_gbdt.onnx
# Unused by the GBDT path — it is fitted on RAW aggregates and deliberately does not z-score.
# Kept for the Bi-LSTM rollback path.
BEHAVIORAL_STATS_PATH=models/behavioral_feature_stats.json
AFFECT_DETECTION_MODE=auto                          # auto | facial_only | behavioral_only | multimodal (ablation, FR14)

# ── Adaptation gate ───────────────────────────────────────────────────────────
# Only `confused` is detectable: measured on held-out data, frustration reads at chance (facial AUC
# 0.590, behavioural recall 0.00), boredom at chance (0.561) and is absent from DUX entirely, and
# DAiSEE has 4 disengaged clips in 1638. Listing states the models cannot see would let the gate
# fire on evidence that does not exist.
# `bored` is reachable for the first time via the geometry channel; `frustrated` is
# omitted because no deployed model can emit it.
ADAPT_STATES=bored,confused
# 0.70 calibrated against real out-of-fold predictions from 46 participants: precision 0.500 at
# ~1.5 interventions/hour, against 0.181 if help were offered unconditionally.
# Per-channel confidence floor. The two channels were calibrated separately and their
# probability distributions are not comparable: gated precision at 0.70 is 0.872 [0.783, 0.937]
# for geometry against 0.500 [0.273, 0.737] for behavioural at its own 0.50.
ADAPT_MIN_CONFIDENCE_GEOMETRY=0.70
# RAISED from 0.50 (Sep 2026). Measured precision at 0.50 is 0.500 -- a coin flip, which cannot
# support a claim about whether confusion interventions help. Stated explicitly rather than
# inherited from ADAPT_MIN_CONFIDENCE, so changing the global cannot silently drop this channel
# back to the coin flip.
ADAPT_MIN_CONFIDENCE_BEHAVIORAL=0.70
ADAPT_MIN_CONFIDENCE=0.70
ADAPT_MIN_CONSECUTIVE=2
ADAPT_COOLDOWN_CYCLES=3
# RANDOMISED TRIAL. Fraction of cycles that clear EVERY gate condition and are then withheld
# anyway, forming the matched control arm.
#
# Without it the study measures regression to the mean: an intervention fires when the detector is
# most confident, which is near the peak of the state, and the state drifts back toward baseline
# on its own -- so the cycles after ANY trigger improve whether or not anything was delivered.
# The withheld cycles are matched to the delivered ones on every gate condition because they are
# drawn from the same set, which also makes the detector's own later readings a valid outcome:
# detector bias applies to both arms and cancels out of the difference.
#
# Set to 0 for a demo where every eligible cycle should intervene. Keep at 0.35 while collecting.
ADAPT_WITHHOLD_RATE=0.35
# Most interventions one session may produce, counted across BOTH arms so they end together.
# The geometry channel triggers ~7.1/hour with no ceiling; past some rate the study stops
# measuring whether help helps and starts measuring reactions to being interrupted.
ADAPT_MAX_PER_SESSION=6
# Whether the FUSED estimate drives the live decision or is only logged. 0 reverts to
# single-modality decisions — see app/agents/nodes/affect_detection.py for why that is defensible.
FUSION_DRIVES_DECISION=1
# BEHAVIORAL_VIEWPORT_W=1920                         # optional: mouse-coord normalization viewport
# BEHAVIORAL_VIEWPORT_H=1080
# RESEARCH_STREAM_MAXLEN=100000                      # optional: research-event stream cap
# PROFILE_COLD_PERSIST_EVERY=10                      # optional: profiler Postgres write cadence

# Which channels may trigger an intervention alone. Granted on measured precision at the
# operating point, not on AUC -- see app/agents/edges.py.
DECISIVE_AFFECT_SOURCES=behavioral_model,fusion,facial_geometry
FUSION_DRIVES_DECISION=0
