# Production backend image (Azure App Service for Linux containers).
# Differs from the dev Dockerfile: no --reload, gunicorn+uvicorn workers, runs the
# entrypoint (fetch facial model from Blob if missing -> alembic upgrade -> serve).
FROM python:3.12-slim

# System deps: curl for the Blob model fetch; libgomp for onnxruntime.
RUN apt-get update && apt-get install -y --no-install-recommends curl libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt gunicorn

COPY . .
RUN chmod +x scripts/azure_entrypoint.sh

# App Service injects PORT (default 8000). Web sockets must be enabled on the Web App.
ENV PORT=8000 PYTHONUNBUFFERED=1
EXPOSE 8000

CMD ["scripts/azure_entrypoint.sh"]
